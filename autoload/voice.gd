extends Node
## Voiced lines. Files live in audio/voice/<speaker>_<md5(text)[:10]>.wav
## (generated by tools/asset_scripts/make_voices.ps1 + process_voices.py).
## Voice.say("Put this on.", "stranger") plays it and ducks the music.

signal finished

var _player: AudioStreamPlayer
var _cache := {}


func _ready() -> void:
	process_mode = Node.PROCESS_MODE_ALWAYS
	_player = AudioStreamPlayer.new()
	_player.bus = "Voice"
	add_child(_player)
	_player.finished.connect(func():
		_duck(false)
		finished.emit())


func path_for(text: String, speaker: String) -> String:
	return "res://audio/voice/%s_%s.wav" % [speaker, text.md5_text().substr(0, 10)]


func has_line(text: String, speaker: String) -> bool:
	return ResourceLoader.exists(path_for(text, speaker))


## Plays the line if a recording exists. Returns its length in seconds (0 if none).
func say(text: String, speaker: String) -> float:
	var path := path_for(text, speaker)
	if not ResourceLoader.exists(path):
		return 0.0
	if not _cache.has(path):
		_cache[path] = load(path)
	var stream: AudioStream = _cache[path]
	_player.stream = stream
	_player.play()
	_duck(true)
	return stream.get_length()


func stop() -> void:
	_player.stop()
	_duck(false)


func is_speaking() -> bool:
	return _player.playing


func _duck(on: bool) -> void:
	var idx := AudioServer.get_bus_index("Music")
	if idx >= 0:
		AudioServer.set_bus_volume_db(idx, -16.0 if on else -8.0)
